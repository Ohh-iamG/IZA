# IZA config. Copy to ".env" next to iza.py, fill in, then: chmod 600 .env
# Every command reads it, including scheduled watch/remind/backup.

# --- required -------------------------------------------------------------
# Local Docker example (see README step 1). Use the password you generated.
IZA_DB_URL=postgresql://postgres:CHANGE_ME@127.0.0.1:5432/postgres
IZA_OWNER=Gerard
IZA_TZ=Australia/Perth

# --- embeddings (local by default; nothing leaves the machine) -------------
IZA_EMBED_BACKEND=local
# IZA_EMBED_MODEL=BAAI/bge-base-en-v1.5

# --- the Confidant (local Ollama by default) ------------------------------
IZA_CHAT_BACKEND=local
IZA_CHAT_MODEL=llama3.1
IZA_OLLAMA_HOST=http://localhost:11434
# API instead (medical data is never sent on this backend):
# IZA_CHAT_BACKEND=api
# OPENAI_CHAT_MODEL=gpt-4o-mini
# OPENAI_API_KEY=

# --- voice ----------------------------------------------------------------
IZA_WHISPER_MODEL=small
IZA_WHISPER_DEVICE=cpu

# --- web app --------------------------------------------------------------
# Local only by default. For phone access over Tailscale set HOST=0.0.0.0
# and a token: python -c "import secrets;print(secrets.token_urlsafe(32))"
IZA_WEB_HOST=127.0.0.1
IZA_WEB_PORT=8765
# IZA_WEB_TOKEN=
# IZA_WEB_SECURE=1          # set when served over HTTPS (e.g. tailscale serve)

# --- reminders to your own phone (ntfy app, long random topic) -----------
# IZA_SELF_WEBHOOK=https://ntfy.sh/iza-gerard-CHANGE-TO-LONG-RANDOM
# IZA_REMINDER_DETAIL=0     # 1 = show medication names on the lock screen

# --- circle alert channels ------------------------------------------------
# IZA_NTFY_TOKEN=           # if your ntfy topics are access-controlled
# IZA_SMTP_HOST=smtp.gmail.com
# IZA_SMTP_PORT=587
# IZA_SMTP_USER=
# IZA_SMTP_PASS=            # an app password, not your account password
# IZA_SMTP_FROM=

# --- watching the watcher -------------------------------------------------
# A free healthchecks.io check, pinged on every `iza watch`. If pings stop
# (laptop off, task broken), healthchecks.io emails/texts you.
# IZA_WATCH_PING_URL=https://hc-ping.com/your-uuid

# --- backups --------------------------------------------------------------
# A folder that syncs off this machine (OneDrive, Google Drive, USB).
# Backups are encrypted; only your passphrase or 2 recovery shares open them.
# IZA_BACKUP_DIR=C:\Users\you\OneDrive\IZA-backups
