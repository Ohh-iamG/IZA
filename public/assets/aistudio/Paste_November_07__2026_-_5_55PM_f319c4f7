10. Recall and disclosure decision
Use two functions:
Plain Text
recall_candidates()
finds potentially relevant memories.
Plain Text
authorise_memory_use()
decides whether each result may influence the response.
Decision structure
TypeScript
type MemoryUseContext = {
userId: string;
agentId: string;
channel: "text" | "voice" | "notification" | "export";
purpose:
| "direct_answer"
| "proactive_follow_up"
| "recommendation"
| "agent_handoff"
| "private_export";
privateContextConfirmed: boolean;
freshAuthentication: boolean;
directlyRequestedByUser: boolean;
};
TypeScript
type MemoryDecision = {
allowed: boolean;
mode:
| "use_naturally"
| "ask_confirmation"
| "use_with_uncertainty"
| "historical_only"
| "do_not_surface";
reasonCode: string;
};
Decision logic
TypeScript
function authoriseMemoryUse(
memory: Memory,
policy: MemoryConsentPolicy,
context: MemoryUseContext
): MemoryDecision {
if (
memory.lifecycleState === "deleted" ||
memory.lifecycleState === "scheduled_for_deletion" ||
memory.consentState === "deleted" ||
memory.consentState === "forget_requested"
) {
return {
allowed: false,
mode: "do_not_surface",
reasonCode: "MEMORY_REMOVED"
};
}
 
if (memory.sensitivityState === "secret_prohibited") {
return {
allowed: false,
mode: "do_not_surface",
reasonCode: "PROHIBITED_SECRET"
};
}
 
if (memory.consentState === "session_only" && !memory.isCurrentSession) {
return {
allowed: false,
mode: "do_not_surface",
reasonCode: "SESSION_EXPIRED"
};
}
 
if (memory.consentState === "vault") {
return {
allowed: false,
mode: "do_not_surface",
reasonCode: "VAULT_ISOLATION"
};
}
 
if (
context.channel === "voice" &&
!policy.allowVoiceSurface
) {
return {
allowed: false,
mode: "do_not_surface",
reasonCode: "VOICE_NOT_ALLOWED"
};
}
 
if (
context.purpose === "proactive_follow_up" &&
!policy.allowProactiveSurface
) {
return {
allowed: false,
mode: "do_not_surface",
reasonCode: "PROACTIVE_USE_NOT_ALLOWED"
};
}
 
if (
policy.requiresPrivateContext &&
!context.privateContextConfirmed
) {
return {
allowed: false,
mode: "ask_confirmation",
reasonCode: "PRIVATE_CONTEXT_REQUIRED"
};
}
 
if (
policy.requiresFreshAuth &&
!context.freshAuthentication
) {
return {
allowed: false,
mode: "ask_confirmation",
reasonCode: "FRESH_AUTH_REQUIRED"
};
}
 
if (
memory.confidenceState === "tentative" ||
memory.confidenceState === "unknown"
) {
return {
allowed: true,
mode: "use_with_uncertainty",
reasonCode: "LOW_CONFIDENCE"
};
}
 
if (
memory.confidenceState === "conflicted"
) {
return {
allowed: false,
mode: "ask_confirmation",
reasonCode: "CONFLICT_REQUIRES_RESOLUTION"
};
}
 
if (
memory.confidenceState === "stale" ||
memory.temporalState === "needs_reconfirmation"
) {
return {
allowed: true,
mode: "historical_only",
reasonCode: "CURRENT_STATUS_UNCONFIRMED"
};
}
 
return {
allowed: true,
mode: "use_naturally",
reasonCode: "AUTHORISED"
};
}
This function should run before prompt construction, not after the model has already seen the memory.

